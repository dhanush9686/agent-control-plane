# Copy to .env. NEVER commit .env (it is gitignored).

# --- Amazon Bedrock (LLMs + embeddings). Credentials come from the normal AWS chain: `aws configure`, AWS_PROFILE,
# --- or an IAM role. Do NOT put AWS keys in this file unless you have no other option.
AWS_REGION=ap-south-1
# ACP_LLM_PROVIDER=bedrock            # bedrock (default) or groq
# ACP_MODEL=apac.amazon.nova-lite-v1:0    # default; region prefix (apac./us./eu.) is chosen from AWS_REGION
# ACP_DAILY_BUDGET_USD=1.00           # hard daily spend cap for all models + embeddings

# --- Pinecone (vector database)
PINECONE_API_KEY=your_pinecone_api_key_here

# --- Only needed if you set ACP_LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
