# Runs the golden-set eval. Needs GROQ_API_KEY at runtime (never baked into the image).
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN python build_index.py
ENV ACP_LLM_PROVIDER=groq
ENTRYPOINT ["python", "-m", "acp.evals"]
CMD ["--pause", "2"]
