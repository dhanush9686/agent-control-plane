MERGE (n:Chunk {id: 'chunk:ecf3fed38a'}) SET n.text = 'Director: Prashanth Neel. Language: Telugu. Setting: Khansaar, a fictional, dystopian city-state run not by a single government but by a fractured council of tribal warlord factions under a fragile, ceremonial monarchy.';
